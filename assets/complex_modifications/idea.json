{
  "title": "IDEA-related mappings",
  "rules": [
    {
      "description": "IntelliJ IDEA ⋀ Shift+Cmd+Opt+KP0 ↦ {desktop≔0, Ctrl+Cmd+F}: Toggle fullscreen",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.jetbrains\\.intellij$"
              ]
            }
          ],
          "from": {
            "key_code": "keypad_0",
            "modifiers": {
              "mandatory": [
                "shift",
                "command",
                "option"
              ]
            }
          },
          "to": [
            {
              "set_variable": {
                "name": "desktop",
                "value": 0
              }
            },
            {
              "key_code": "f",
              "modifiers": [
                "control",
                "command"
              ]
            }
          ]
        }
      ]
    }
  ]
}
